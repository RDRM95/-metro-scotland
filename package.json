{
  "name": "metro-scotland",
  "version": "1.0.0",
  "description": "METRO SCOTLAND — THE SURFACE NETWORK. A cinematic pixel-art military horror short rendered in the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "export:frames": "node scripts/export-video.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
